---
import brand from '../data/brand.json';
import '../styles/global.css';
import {
  absolute,
  breadcrumbNode,
  faqNode,
  graph,
  isProduction,
  jsonLdString,
  menuGraphNode,
  pageUrl,
  restaurantNode,
  webPageNode,
  websiteNode,
  withBase,
} from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  preloadHero?: boolean;
  faq?: { q: string; a: string }[];
  breadcrumb?: { name: string; path: string }[];
}

const { seo, business, colors, fonts, nav } = brand;
const {
  title = seo.title,
  description = seo.description,
  path = '',
  image = seo.ogImage,
  imageAlt = seo.ogImageAlt,
  noindex: noindexProp = false,
  preloadHero = false,
  faq,
  breadcrumb,
} = Astro.props;

const noindex = noindexProp || !isProduction;
const isHome = path === '';
const canonical = pageUrl(path);
const ogImage = absolute(image);
const brandShort = brand.brandName.split(' · ')[0];
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const cssVars = `:root{--c-background:${colors.background};--c-surface:${colors.surface};--c-text:${colors.text};--c-primary:${colors.primary};--c-secondary:${colors.secondary};--c-accent:${colors.accent};--c-muted:${colors.extra.textMuted};--c-line:${colors.extra.border};--c-lacquer:${colors.extra.lacquerRed};--c-on-lacquer:${colors.extra.onLacquerRed};--c-on-primary:${colors.extra.onPrimary};--c-deep:${colors.extra.backgroundDeep};--c-wood:${colors.extra.woodWarm}}`;

const nodes: Record<string, unknown>[] = [restaurantNode({ withMenu: isHome }), webPageNode({ path, name: title, description, image })];
if (isHome) nodes.push(websiteNode(), menuGraphNode());
if (breadcrumb) nodes.push(breadcrumbNode(breadcrumb));
if (faq?.length) nodes.push(faqNode(faq, path));
const jsonLd = graph(nodes);
---

<!doctype html>
<html lang={seo.lang} class="bg-background">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={brandShort} />
    <meta name="application-name" content={brandShort} />
    <meta name="keywords" content={seo.keywords.join(', ')} />
    <meta name="theme-color" content={seo.themeColor} />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={seo.locale.replace('_', '-')} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <link rel="icon" href={withBase('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={withBase('icon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />
    <link rel="sitemap" type="application/xml" href={withBase('sitemap-index.xml')} />

    <meta name="geo.region" content={seo.geo.region} />
    <meta name="geo.placename" content={seo.geo.placename} />
    <meta name="geo.position" content={seo.geo.position} />
    <meta name="ICBM" content={seo.geo.position.replace(';', ', ')} />

    <meta property="og:type" content={isHome ? 'restaurant.restaurant' : 'website'} />
    <meta property="og:site_name" content={brandShort} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(seo.ogImageWidth)} />
    <meta property="og:image:height" content={String(seo.ogImageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="restaurant:contact_info:street_address" content={business.address.streetAddress} />
    <meta property="restaurant:contact_info:locality" content={business.address.addressLocality} />
    <meta property="restaurant:contact_info:region" content={business.address.addressRegion} />
    <meta property="restaurant:contact_info:postal_code" content={business.address.postalCode} />
    <meta property="restaurant:contact_info:country_name" content="España" />
    <meta property="restaurant:contact_info:phone_number" content={business.phone} />
    <meta property="place:location:latitude" content={String(business.geo.latitude)} />
    <meta property="place:location:longitude" content={String(business.geo.longitude)} />
    <meta name="twitter:card" content={seo.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {preloadHero && <link rel="preload" as="image" href={brand.assets.heroImage} fetchpriority="high" />}
    <link rel="preload" as="style" href={fonts.googleFontsUrl} />
    <link rel="stylesheet" href={fonts.googleFontsUrl} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fonts.googleFontsUrl} /></noscript>

    <style is:inline set:html={cssVars} />
    <style is:inline>
      /* initial hidden state only when JS + motion are available (no flash, no hidden content otherwise) */
      .js-anim [data-hero-line] { opacity: 0; }
      .js-anim [data-hero-fade] { opacity: 0; }
    </style>
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-anim');
    </script>
    <script type="application/ld+json" set:html={jsonLdString(jsonLd)} />
  </head>
  <body>
    <a
      href="#contenido"
      class="fixed left-4 top-4 z-[100] -translate-y-24 rounded-full bg-primary px-5 py-3 text-sm font-semibold text-on-primary transition-transform focus:translate-y-0"
    >
      {nav.skipToContent}
    </a>
    <slot />
    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
