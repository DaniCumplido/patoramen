---
import { ArrowUpRight } from 'lucide-react';
import brand from '../data/brand.json';

const { footer, assets, business, nav } = brand;
---

<footer class="relative isolate overflow-hidden bg-deep">
  <!-- CTA strip over night-street photo -->
  <div class="relative overflow-hidden border-t border-line">
    <img
      src={assets.decorativeImages.nightStreet}
      alt={assets.decorativeImagesAlt.nightStreet}
      width="2400"
      height="1200"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-deep via-deep/80 to-deep/40"></div>
    <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-deep via-transparent to-deep/60"></div>
    <div class="relative mx-auto flex max-w-[1440px] flex-col items-start justify-between gap-8 px-5 py-20 sm:px-8 md:flex-row md:items-center md:py-28 lg:px-14">
      <p class="max-w-2xl font-serif text-5xl font-light leading-[1.02] text-ink md:text-7xl">
        {footer.cta.title}
      </p>
      <a href={footer.cta.href} class="btn btn-primary shrink-0">
        <span>{footer.cta.label}</span>
        <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </div>

  <div class="relative mx-auto max-w-[1440px] px-5 pb-10 pt-16 sm:px-8 lg:px-14">
    <span aria-hidden="true" lang="zh-Hans" class="pointer-events-none absolute -bottom-6 right-4 select-none font-cjk text-[14rem] font-light leading-none text-ink/[0.04] md:text-[22rem]">{footer.kanji}</span>

    <div class="relative grid gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="font-serif text-4xl font-light text-ink">{brand.brandName}</p>
        <p class="mt-4 max-w-xs text-muted">{footer.tagline}</p>
      </div>
      {
        footer.columns.map((col) => (
          <div class="md:col-span-2 md:first:col-start-6 lg:col-span-2">
            <h2 class="eyebrow !font-sans !text-[0.68rem] before:hidden">{col.title}</h2>
            <ul class="mt-5 space-y-2 text-sm text-ink/90">
              {col.lines.map((l) => <li>{l}</li>)}
            </ul>
          </div>
        ))
      }
    </div>

    <nav aria-label={brand.brandName} class="relative mt-14 flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-8 text-xs uppercase tracking-[0.18em] text-muted">
      {nav.items.map((i) => <a href={i.href} class="hover:text-primary">{i.label}</a>)}
      <span aria-hidden="true" class="hidden flex-1 md:block"></span>
      {business.social.map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer" class="hover:text-primary">{s.label}</a>)}
    </nav>

    <div class="relative mt-8 flex flex-col gap-4 text-xs text-muted md:flex-row md:items-center md:justify-between">
      <p>{footer.copyright}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {footer.links.map((l) => <li><a href={l.href} class="hover:text-primary">{l.label}</a></li>)}
      </ul>
      <p class="italic">{footer.credit}</p>
    </div>
    <p class="relative mt-6 text-[0.68rem] text-muted/80">{footer.placeholderNote}</p>
  </div>
</footer>
