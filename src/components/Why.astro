---
import brand from '../data/brand.json';
import Title from './Title.astro';

const { why } = brand;
---

<section id="por-que" class="section-pad relative overflow-x-clip bg-surface">
  <div class="container-x relative z-10">
    <header class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-6" data-fade>{why.eyebrow}</p>
        <Title segments={why.title} />
      </div>
      <p class="max-w-md text-lg leading-relaxed text-muted lg:col-span-5 lg:pb-3" data-fade>{why.intro}</p>
    </header>

    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 md:mt-20">
      {
        why.items.map((item) => (
          <li data-fade class="relative overflow-hidden rounded-sm border border-line bg-background/60 p-7 md:p-8">
            <span aria-hidden="true" lang="zh-Hans" class="font-cjk text-5xl font-light leading-none text-primary/80">{item.kanji}</span>
            <h3 class="mt-6 font-serif text-3xl font-light leading-tight text-ink">{item.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
