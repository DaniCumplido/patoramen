---
import brand from '../data/brand.json';

const { nav, brandName } = brand;
const [name, kanji] = brandName.split(' · ');
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent before:pointer-events-none before:absolute before:inset-x-0 before:top-0 before:-z-10 before:h-28 before:bg-gradient-to-b before:from-deep/90 before:to-transparent before:transition-opacity before:duration-500 data-[scrolled=true]:before:opacity-0 transition-[background-color,border-color,backdrop-filter] duration-500 data-[scrolled=true]:border-line/60 data-[scrolled=true]:bg-background/85 data-[scrolled=true]:backdrop-blur-md"
  data-scrolled="false"
>
  <nav class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-6 px-5 sm:px-8 md:h-20 lg:px-14" aria-label={name}>
    <a href={nav.brandHref} class="group flex items-baseline gap-3" aria-label={brandName}>
      <span class="font-serif text-2xl font-medium tracking-tight text-ink md:text-[1.7rem]">{name}</span>
      <span lang="zh-Hans" class="font-cjk text-sm text-primary transition-transform duration-500 group-hover:-translate-y-0.5">{kanji}</span>
    </a>

    <ul class="hidden items-center gap-9 lg:flex">
      {
        nav.items
          .filter((i) => i.href !== nav.cta.href && i.href !== nav.brandHref)
          .map((i) => (
            <li>
              <a
                href={i.href}
                data-nav-link
                class="relative py-2 text-[0.72rem] font-medium uppercase tracking-[0.24em] text-ink transition-colors hover:text-primary aria-[current=true]:text-primary after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-primary after:transition-transform after:duration-500 hover:after:scale-x-100 aria-[current=true]:after:scale-x-100"
              >
                {i.label}
              </a>
            </li>
          ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a href={nav.cta.href} class="btn btn-primary hidden !px-6 !py-3 sm:inline-flex"><span>{nav.cta.label}</span></a>
      <button
        type="button"
        id="menu-toggle"
        class="relative flex h-11 w-11 items-center justify-center rounded-full border border-ink/25 bg-background/30 backdrop-blur-md lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={nav.openMenuLabel}
        data-open-label={nav.openMenuLabel}
        data-close-label={nav.closeMenuLabel}
      >
        <span class="absolute h-px w-5 -translate-y-[5px] bg-ink transition-transform duration-300 [[aria-expanded=true]_&]:translate-y-0 [[aria-expanded=true]_&]:rotate-45"></span>
        <span class="absolute h-px w-5 translate-y-[5px] bg-ink transition-transform duration-300 [[aria-expanded=true]_&]:translate-y-0 [[aria-expanded=true]_&]:-rotate-45"></span>
      </button>
    </div>
  </nav>
</header>

<div
    id="mobile-menu"

    class="fixed inset-0 z-40 hidden flex-col justify-center bg-deep/95 px-8 pb-10 pt-24 backdrop-blur-xl lg:hidden"
  >
    <span aria-hidden="true" lang="zh-Hans" class="kanji-v absolute bottom-6 right-4 text-[34vw] opacity-[0.06]">{brand.hero.kanjiVertical}</span>
    <ul class="relative flex flex-col gap-1">
      {
        nav.items.map((i, idx) => (
          <li>
            <a
              href={i.href}
              data-menu-link
              class="flex items-baseline gap-4 border-b border-line/70 py-3 font-serif text-[2.4rem] font-light leading-none text-ink hover:text-primary"
            >
              <span class="font-sans text-[0.65rem] tracking-[0.25em] text-secondary">{String(idx + 1).padStart(2, '0')}</span>
              {i.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={nav.cta.href} data-menu-link class="btn btn-primary relative mt-8 self-start"><span>{nav.cta.label}</span></a>
  </div>

<script>
  const header = document.getElementById('site-nav') as HTMLElement | null;
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;

  if (header && toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '');
      menu.classList.toggle("hidden", !open);
      menu.classList.toggle("flex", open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) header.dataset.scrolled = 'true';
      else onScroll();
    };
    const onScroll = () => {
      if (toggle.getAttribute('aria-expanded') === 'true') return;
      header.dataset.scrolled = String(window.scrollY > 40);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // current section highlight
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => map.set(l.getAttribute('href')!.slice(1), l));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            links.forEach((l) => l.removeAttribute('aria-current'));
            map.get(en.target.id)?.setAttribute('aria-current', 'true');
          }
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    map.forEach((_, id) => {
      const s = document.getElementById(id);
      if (s) io.observe(s);
    });
  }
</script>
