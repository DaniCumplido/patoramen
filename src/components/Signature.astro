---
import { ArrowUpRight } from 'lucide-react';
import brand from '../data/brand.json';
import { cjkNumeral } from '../lib/utils';
import Title from './Title.astro';
import Kanji from './Kanji.astro';
import DishImage from './react/DishImage';

const { signature } = brand;
---

<section id="platos" class="section-pad relative overflow-x-clip bg-background">
  <Kanji placement="platos-left" class="left-1 top-24 md:left-6" parallax={0.4} />
  <Kanji placement="platos-right" class="right-1 top-[48%] md:right-6" parallax={0.3} />

  <div class="container-x relative z-10">
    <header class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <p class="eyebrow mb-6" data-fade>{signature.eyebrow}</p>
        <Title segments={signature.title} class="max-w-[14ch]" />
      </div>
      <p class="max-w-md text-lg leading-relaxed text-muted lg:col-span-4 lg:pb-3" data-fade>{signature.intro}</p>
    </header>

    <div class="mt-20 space-y-28 md:mt-32 md:space-y-44">
      {
        signature.dishes.map((dish, i) => {
          const flip = i % 2 === 1;
          return (
            <article class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16" aria-labelledby={`dish-${dish.id}`}>
              <div class:list={['relative lg:col-span-7', flip && 'lg:order-2']}>
                <span
                  aria-hidden="true"
                  lang="zh-Hans"
                  class:list={[
                    'absolute -top-12 z-20 font-cjk text-[7rem] font-light leading-none text-primary/80 md:-top-20 md:text-[11rem]',
                    flip ? 'right-2 md:-right-6' : 'left-2 md:-left-6',
                  ]}
                  data-fade
                >
                  {cjkNumeral(i + 1)}
                </span>
                <div data-clip data-parallax-scope class="relative aspect-[4/5] overflow-hidden rounded-[2px] md:aspect-[5/4] lg:aspect-[4/4.6]">
                  <div data-clip-inner class="absolute inset-0">
                    <div data-parallax="0.1" class="absolute inset-x-0 -top-[12.5%] h-[125%]">
                      <DishImage client:visible src={dish.image} alt={dish.alt} />
                    </div>
                  </div>
                  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/60 via-transparent to-transparent"></div>
                  <span aria-hidden="true" class="pointer-events-none absolute inset-0 border border-ink/10"></span>
                </div>

                <!-- Floating price card, layered over the photo -->
                <div
                  data-fade
                  class:list={[
                    'absolute -bottom-8 z-20 rounded-sm border border-ink/15 bg-background/80 px-6 py-5 backdrop-blur-md md:-bottom-10',
                    flip ? 'left-4 md:-left-10' : 'right-4 md:-right-10',
                  ]}
                >
                  <p class="font-serif text-4xl font-light text-primary md:text-5xl">{dish.price}</p>
                  <p class="mt-1 max-w-[16rem] text-xs uppercase tracking-[0.14em] text-muted">{dish.priceNote}</p>
                </div>
              </div>

              <div class:list={['lg:col-span-5', flip && 'lg:order-1']}>
                <p class="eyebrow" data-fade>{dish.kicker}</p>
                <h3 id={`dish-${dish.id}`} class="mt-5 font-serif text-5xl font-light leading-[1.02] text-ink md:text-6xl" data-fade>
                  {dish.name}
                </h3>
                <p lang={dish.asideLang} class="mt-3 font-cjk text-xl tracking-[0.2em] text-secondary" data-fade>
                  {dish.aside}
                </p>
                <p class="mt-8 max-w-lg text-base leading-relaxed text-muted md:text-lg" data-fade>{dish.description}</p>
                <ul class="mt-8 flex flex-wrap gap-2" data-fade>
                  {
                    dish.tags.map((t) => (
                      <li class="rounded-full border border-line px-4 py-1.5 text-[0.7rem] uppercase tracking-[0.16em] text-ink/85">{t}</li>
                    ))
                  }
                </ul>
                <a
                  href="#carta"
                  class="group mt-10 inline-flex items-center gap-3 border-b border-primary/50 pb-1 text-[0.78rem] font-semibold uppercase tracking-[0.2em] text-primary transition-colors hover:border-primary hover:text-ink"
                  data-fade
                >
                  {signature.viewDishLabel}
                  <ArrowUpRight className="h-4 w-4 transition-transform duration-500 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true" />
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
