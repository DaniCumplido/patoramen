---
import brand from '../data/brand.json';
import { Marquee } from './ui/marquee';

const { marquee, motion } = brand;
const style = { '--duration': `${marquee.speedSeconds}s` } as Record<string, string>;
const isCjk = (w: string) => /[　-鿿]/.test(w);
---

<section aria-label={brand.brandName} class="relative border-y border-line/80 bg-deep py-5">
  <Marquee
    pauseOnHover={motion.marquee.pauseOnHover}
    reverse={motion.marquee.direction !== 'left'}
    repeat={4}
    className="!p-0 [--gap:2.5rem]"
    style={style}
  >
    {
      marquee.words.map((w) => (
        <span class="flex items-center gap-10 whitespace-nowrap">
          <span
            class:list={[
              'font-serif text-4xl font-light italic text-ink/90 md:text-6xl',
              isCjk(w) && 'font-cjk not-italic text-primary',
            ]}
            lang={isCjk(w) ? 'zh-Hans' : undefined}
          >
            {w}
          </span>
          <span aria-hidden="true" class="text-lg text-secondary">
            {marquee.separator}
          </span>
        </span>
      ))
    }
  </Marquee>
</section>
