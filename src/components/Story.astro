---
import brand from '../data/brand.json';
import Title from './Title.astro';
import Kanji from './Kanji.astro';
import PullQuote from './react/PullQuote';
import Stats from './react/Stats';

const { story, assets } = brand;
const caption = story.overlays.find((o) => o.type === 'caption');
const badge = story.overlays.find((o) => o.type === 'badge');
const kanjiOverlay = story.overlays.find((o) => o.type === 'kanji');
---

<section id="historia" class="section-pad relative overflow-x-clip bg-deep">
  <Kanji placement="historia-left" class="bottom-24 left-1 md:left-4" parallax={0.4} />

  <div class="container-x relative z-10">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-20">
      <!-- Layered imagery (native sticky, no scroll hijacking) -->
      <div class="relative lg:col-span-5">
        <div class="lg:sticky lg:top-24">
          <div class="relative pb-24 pr-6 md:pr-12">
            <div data-clip data-parallax-scope class="relative aspect-[3/4] overflow-hidden rounded-[2px]">
              <div data-clip-inner class="absolute inset-0">
                <div data-parallax="0.1" class="absolute inset-x-0 -top-[12.5%] h-[125%]">
                  <img
                    src={story.image}
                    alt={story.imageAlt}
                    width="2400"
                    height="3200"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                </div>
              </div>
              <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-background/20"></div>
              {
                kanjiOverlay && (
                  <span
                    aria-hidden="true"
                    lang="zh-Hans"
                    class="kanji-v absolute left-3 top-1/2 -translate-y-1/2 text-[5.5rem] md:text-[8rem]"
                    style={`opacity:${kanjiOverlay.opacity}`}
                  >
                    {kanjiOverlay.text}
                  </span>
                )
              }
              {
                badge && (
                  <span class="absolute right-4 top-4 rounded-full border border-primary/60 bg-background/85 px-4 py-2 text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-primary backdrop-blur-md">
                    {badge.text}
                  </span>
                )
              }
              {
                caption && (
                  <p class="absolute bottom-4 left-4 text-[0.72rem] uppercase tracking-[0.24em] text-ink">{caption.text}</p>
                )
              }
            </div>

            <!-- secondary layer overlapping the main photo -->
            <figure class="absolute -right-0 bottom-0 w-[58%] md:-right-4">
              <div data-clip class="relative aspect-[4/5] overflow-hidden rounded-[2px] border-4 border-deep shadow-[0_30px_60px_-20px_rgba(0,0,0,0.8)]">
                <div data-clip-inner class="absolute inset-0">
                  <img
                    src={story.secondaryImage}
                    alt={story.secondaryImageAlt}
                    width="1600"
                    height="2000"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                </div>
              </div>
              <figcaption class="mt-3 text-[0.68rem] uppercase tracking-[0.2em] text-muted">{story.secondaryImageCaption}</figcaption>
            </figure>
          </div>
        </div>
      </div>

      <!-- Copy -->
      <div class="lg:col-span-7 lg:pt-10">
        <div class="relative">
          <span aria-hidden="true" lang="zh-Hans" class="absolute -top-10 right-0 font-cjk text-[10rem] font-light leading-none text-primary/[0.09] md:text-[16rem]" data-parallax="0.3">{story.kanji}</span>
          <p class="eyebrow mb-6" data-fade>{story.eyebrow}</p>
          <Title segments={story.title} class="relative max-w-[12ch]" />
        </div>

        <div class="mt-12 max-w-2xl space-y-6 text-base leading-[1.8] text-muted md:text-lg">
          {story.paragraphs.map((p, i) => <p data-fade class:list={[i === 0 && 'first-letter:float-left first-letter:mr-3 first-letter:font-serif first-letter:text-7xl first-letter:leading-[0.8] first-letter:text-primary']}>{p}</p>)}
        </div>

        <div class="mt-16" data-fade>
          <PullQuote client:visible />
        </div>

        <div class="mt-16">
          <Stats client:visible />
        </div>
      </div>
    </div>

    <!-- Decorative image pair -->
    <div class="mt-24 grid gap-4 md:mt-32 md:grid-cols-12">
      <div data-clip class="relative aspect-[16/10] overflow-hidden md:col-span-7">
        <div data-clip-inner class="absolute inset-0">
          <img src={assets.decorativeImages.carving} alt={assets.decorativeImagesAlt.carving} width="2400" height="1500" loading="lazy" decoding="async" class="h-full w-full object-cover" />
        </div>
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-background/50 to-transparent"></div>
      </div>
      <div data-clip class="relative aspect-[16/10] overflow-hidden md:col-span-5 md:mt-16 md:aspect-auto">
        <div data-clip-inner class="absolute inset-0">
          <img src={assets.decorativeImages.shreddedDuck} alt={assets.decorativeImagesAlt.shreddedDuck} width="2400" height="1500" loading="lazy" decoding="async" class="h-full w-full object-cover" />
        </div>
        <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-background/50 to-transparent"></div>
      </div>
    </div>
  </div>
</section>
