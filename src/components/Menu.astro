---
import { ArrowUpRight, Download } from 'lucide-react';
import brand from '../data/brand.json';
import Title from './Title.astro';
import Kanji from './Kanji.astro';
import MenuTabs from './react/MenuTabs';
import MenuHighlights from './react/MenuHighlights';

const { menu } = brand;
const hasPdf = menu.downloadMenuHref && menu.downloadMenuHref !== '#';
---

<section id="carta" class="section-pad relative overflow-x-clip bg-background">
  <Kanji placement="carta-right" class="right-1 top-16 md:right-6" parallax={0.35} />

  <div class="container-x relative z-10">
    <header class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-6" data-fade>{menu.eyebrow} <span aria-hidden="true" lang="zh-Hans" class="ml-2 font-cjk tracking-normal">{menu.kanji}</span></p>
        <Title segments={menu.title} />
      </div>
      <p class="max-w-md text-lg leading-relaxed text-muted lg:col-span-5 lg:pb-3" data-fade>{menu.intro}</p>
    </header>

    <div class="mt-14 md:mt-20" data-fade>
      <MenuTabs client:visible />
    </div>

    <div class="mt-8 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <p class="max-w-xl text-sm leading-relaxed text-muted">{menu.allergensNote}</p>
      <div class="flex flex-wrap gap-3">
        {
          hasPdf && (
            <a href={menu.downloadMenuHref} class="btn btn-ghost">
              <Download className="h-4 w-4" aria-hidden="true" />
              <span>{menu.downloadMenuLabel}</span>
            </a>
          )
        }
        <a href="#pedir" class="btn btn-primary">
          <span>Pedir ahora</span>
          <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="mt-24 md:mt-32">
      <MenuHighlights client:visible />
    </div>
  </div>
</section>
