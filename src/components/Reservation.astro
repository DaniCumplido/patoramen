---
import { Clock, Mail, MapPin, Phone, ArrowUpRight, AtSign } from 'lucide-react';
import brand from '../data/brand.json';
import Title from './Title.astro';
import Kanji from './Kanji.astro';
import ReservationForm from './react/ReservationForm';

const { reservation, business, footer } = brand;
const [visit, hours, contact] = footer.columns;
---

<section id={reservation.id} class="section-pad relative isolate overflow-x-clip bg-deep">
  <Kanji placement="reservas-right" class="right-1 top-10 md:right-6" parallax={0.3} />

  <div class="container-x relative z-10">
    <header class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-6" data-fade>{reservation.eyebrow}</p>
        <Title segments={reservation.title} />
      </div>
      <p class="max-w-lg text-lg leading-relaxed text-muted lg:col-span-5 lg:pb-3" data-fade>{reservation.copy}</p>
    </header>

    <div class="mt-16 grid gap-10 lg:mt-24 lg:grid-cols-12 lg:gap-14">
      <!-- Info column: photo + contact block layered -->
      <div class="lg:col-span-5">
        <div data-clip class="relative aspect-[4/3] overflow-hidden rounded-[2px] lg:aspect-[4/4.2]">
          <div data-clip-inner class="absolute inset-0">
            <img
              src={reservation.image}
              alt={reservation.imageAlt}
              width="2400"
              height="1800"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </div>
          <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-background via-background/20 to-transparent"></div>
          <span aria-hidden="true" lang="zh-Hans" class="kanji-v absolute right-5 top-5 text-5xl opacity-70 text-primary">{reservation.kanji}</span>
        </div>

        <address class="relative z-10 -mt-24 ml-4 rounded-sm border border-ink/15 bg-background/85 p-7 not-italic backdrop-blur-md sm:ml-10" data-fade>
          <ul class="space-y-6 text-sm">
            <li class="flex gap-4">
              <MapPin className="mt-0.5 h-5 w-5 shrink-0 text-primary" aria-hidden="true" />
              <div>
                <p class="eyebrow !text-[0.65rem] before:hidden">{visit.title}</p>
                <p class="mt-2 text-ink">{business.address.display}</p>
                <a
                  href={business.mapUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-2 inline-flex items-center gap-1.5 text-primary underline-offset-4 hover:underline"
                >
                  {business.address.streetAddress}
                  <ArrowUpRight className="h-3.5 w-3.5" aria-hidden="true" />
                  <span class="sr-only">Google Maps</span>
                </a>
              </div>
            </li>
            <li class="flex gap-4">
              <Clock className="mt-0.5 h-5 w-5 shrink-0 text-primary" aria-hidden="true" />
              <div class="w-full">
                <p class="eyebrow !text-[0.65rem] before:hidden">{hours.title}</p>
                <dl class="mt-2 space-y-1.5">
                  {
                    business.openingHours.display.map((h) => (
                      <div class="flex flex-wrap justify-between gap-x-4">
                        <dt class="text-muted">{h.days}</dt>
                        <dd class="text-ink">{h.hours}</dd>
                      </div>
                    ))
                  }
                </dl>
              </div>
            </li>
            <li class="flex gap-4">
              <Phone className="mt-0.5 h-5 w-5 shrink-0 text-primary" aria-hidden="true" />
              <div>
                <p class="eyebrow !text-[0.65rem] before:hidden">{contact.title}</p>
                <a href={business.phoneHref} class="mt-2 block text-ink hover:text-primary">{business.phone}</a>
                <a href={business.emailHref} class="mt-1 flex items-center gap-2 text-ink hover:text-primary">
                  <Mail className="h-3.5 w-3.5 text-muted" aria-hidden="true" />{business.email}
                </a>
              </div>
            </li>
            <li class="flex gap-4">
              <AtSign className="mt-0.5 h-5 w-5 shrink-0 text-primary" aria-hidden="true" />
              <ul class="flex flex-wrap gap-x-5 gap-y-1">
                {
                  business.social.map((s) => (
                    <li>
                      <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-ink hover:text-primary">
                        {s.label} <span class="text-muted">{s.handle}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </li>
          </ul>
        </address>
      </div>

      <div class="lg:col-span-7" data-fade>
        <ReservationForm client:visible />
      </div>
    </div>
  </div>
</section>
