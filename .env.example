# Resend API key (https://resend.com). Without it /api/reservar answers 503 "not configured".
RESEND_API_KEY=
# Where reservation requests are delivered (falls back to brand.json reservation.email.to)
RESERVATION_TO_EMAIL=
# Optional: verified sender, e.g. "Pato Ramen <reservas@yourdomain.com>" (falls back to brand.json)
RESERVATION_FROM_EMAIL=
